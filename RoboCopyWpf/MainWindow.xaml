<Window x:Class="RoboCopyUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROBOCOPY 快速复制工具"
        Width="1160" Height="740"
        MinWidth="980" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="PingFang SC, Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Margin="22"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>

        <Grid x:Name="RootContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="ROBOCOPY 快速复制工具" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="  安全快速的复制备份工具"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaximizeRestore" ToolTip="最大化/还原">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource DangerIconButton}" Click="OnClose" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== 内容区 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Grid Grid.Column="0" Margin="0,6,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="NavList" Style="{StaticResource NavList}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Tag="copy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;"/>
                                <TextBlock Text="快速复制" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="advanced">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"/>
                                <TextBlock Text="高级选项" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="help">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;"/>
                                <TextBlock Text="使用说明" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="12,8,12,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="快速预设" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Button x:Name="btnPresetBackup" Style="{StaticResource ChipButton}" Content="📦 常规备份" Click="OnPreset" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                            <Button x:Name="btnPresetMirror" Style="{StaticResource ChipButton}" Content="🪞 完整镜像" Click="OnPreset" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                            <Button x:Name="btnPresetMigrate" Style="{StaticResource ChipButton}" Content="🚚 数据迁移" Click="OnPreset" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                            <Button x:Name="btnPresetDry" Style="{StaticResource ChipButton}" Content="🔍 试运行" Click="OnPreset" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 页面容器 -->
                <Grid Grid.Column="1" Margin="0,6,14,12">

                    <!-- ============ 页面1：快速复制 ============ -->
                    <Grid x:Name="PageCopy">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 源/目标 -->
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="源目录与目标目录" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="源目录" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrc" Grid.Column="1"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="浏览…"
                                            Height="34" Padding="12,3" Margin="6,0,0,0" Click="BrowseSrc"/>
                                    <TextBlock Grid.Column="4" Text="目标目录" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtDst" Grid.Column="5"/>
                                    <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Content="浏览…"
                                            Height="34" Padding="12,3" Margin="6,0,0,0" Click="BrowseDst"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 模式 + 筛选 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="复制模式与文件筛选" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="复制模式" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbMode" Grid.Column="1"/>
                                    <TextBlock Grid.Column="3" Text="仅复制" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtInc" Grid.Column="4" ToolTip="只复制这些文件，多个用空格分隔，留空为全部"/>
                                    <TextBlock Grid.Column="6" Text="日志文件" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtLog" Grid.Column="7" ToolTip="复制日志写入的路径，留空则不写日志"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="排除文件" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtXf" Grid.Column="1" ToolTip="排除这些文件，多个用空格分隔"/>
                                    <TextBlock Grid.Column="3" Text="排除目录" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtXd" Grid.Column="4" ToolTip="排除这些目录，多个用空格分隔"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 操作 + 日志 -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnStart" Style="{StaticResource PrimaryButton}" Content="▶  开始复制" Click="OnStart" Width="132"/>
                                    <Button x:Name="btnStop" Style="{StaticResource SecondaryButton}" Content="⏹  停止" Click="OnStop" IsEnabled="False" Margin="10,0,0,0" Width="96"/>
                                    <Button x:Name="btnCopyCmd" Style="{StaticResource SecondaryButton}" Content="📋  复制命令" Click="OnCopyCommand" Margin="10,0,0,0" Width="112"/>
                                    <Button x:Name="btnClearLog" Style="{StaticResource SecondaryButton}" Content="🗑  清空日志" Click="OnClearLog" Margin="10,0,0,0" Width="102"/>
                                    <TextBlock x:Name="lblStatus" Text="就绪" Style="{StaticResource FieldLabel}" Margin="18,0,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="prog" Grid.Row="1" Height="8" Margin="0,12,0,10"
                                             Foreground="{StaticResource AccentBrush}" Background="#FF202020"
                                             BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                                <ListBox x:Name="logList" Grid.Row="2" Style="{StaticResource LogList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Stamp}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Text}" Foreground="{Binding Color}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 页面2：高级选项 ============ -->
                    <Grid x:Name="PageAdvanced" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,12">
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="复制选项" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="鼠标悬停可查看每项说明。选择了互斥的选项时，程序会自动提醒。"
                                                   Style="{StaticResource HintText}"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Border Style="{StaticResource OptionChip}" ToolTip="多线程复制（1-128，默认8）。不能与限速同时使用">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="chkMT" Content="多线程" IsChecked="True"/>
                                                    <TextBox x:Name="txtMT" Width="52" Margin="8,0,0,0" Text="16"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="复制失败时的重试次数">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="chkR" Content="重试" IsChecked="True"/>
                                                    <TextBox x:Name="txtR" Width="52" Margin="8,0,0,0" Text="3"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="每次重试前等待的秒数">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="chkW" Content="等待" IsChecked="True"/>
                                                    <TextBox x:Name="txtW" Width="52" Margin="8,0,0,0" Text="5"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="限制复制速度，适合网络传输。不能与多线程同时使用">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="chkIPG" Content="限速"/>
                                                    <TextBox x:Name="txtIPG" Width="52" Margin="8,0,0,0" Text="100"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="可重启模式，断点续传，适合大文件/网络复制">
                                                <CheckBox x:Name="chkZ" Content="可重启"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="备份模式，可复制受限文件，需要以管理员身份运行">
                                                <CheckBox x:Name="chkB" Content="备份模式"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="先普通复制，失败再用备份模式">
                                                <CheckBox x:Name="chkZB" Content="优先备份"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="排除目录联接点，避免无限循环" >
                                                <CheckBox x:Name="chkXJ" Content="排除联接点" IsChecked="True"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="FAT 文件时间，修正 2 秒时间差">
                                                <CheckBox x:Name="chkFFT" Content="FAT 时间"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="复制文件安全设置（ACL）">
                                                <CheckBox x:Name="chkSEC" Content="安全设置"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="复制全部文件信息（含安全设置、时间戳）">
                                                <CheckBox x:Name="chkCopyAll" Content="复制全部信息"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="复制目录时间戳">
                                                <CheckBox x:Name="chkDcopyT" Content="目录时间戳"/>
                                            </Border>
                                            <Border Style="{StaticResource OptionChip}" ToolTip="修复文件时间戳">
                                                <CheckBox x:Name="chkTimfix" Content="修复时间"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="试运行与安全" Style="{StaticResource SectionTitle}"/>
                                        <Border Style="{StaticResource OptionChip}" HorizontalAlignment="Left" ToolTip="只列出将执行的操作，不实际复制/删除文件，建议先试运行">
                                            <CheckBox x:Name="chkL" Content="仅试运行（只预览，不实际复制）"/>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}">
                                            ⚠️ 危险模式提醒：「镜像同步」「清理多余文件」「移动全部」会删除目标目录中源没有的文件/目录。执行前程序会二次确认，建议先勾选「仅试运行」预览。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ 页面3：使用说明 ============ -->
                    <Grid x:Name="PageHelp" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,12">
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="使用方法" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            1. 在「快速复制」页填写源目录与目标目录，选择复制模式。&#10;
                                            2. 按需设置文件筛选（仅复制 / 排除文件 / 排除目录）与日志文件。&#10;
                                            3. 点击「▶ 开始复制」，下方日志实时显示进度；需要管理员权限的选项（如备份模式）请右键以管理员身份运行。&#10;
                                            4. 「📋 复制命令」可把生成的命令复制到剪贴板，方便手动执行或写入计划任务。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="任务结果说明" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            · 0 – 7 均表示成功：0 = 无文件复制；1 = 有文件已复制；2 = 有额外文件；3 = 1+2；4 = 有不匹配文件；5 = 1+4；6 = 2+4；7 = 1+2+4。&#10;
                                            · 8 及以上表示出错：8 = 有文件复制失败；16 = 严重错误。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="快速预设" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            · 📦 常规备份：复制全部子目录、断点续传、多线程加速、失败重试、保存日志。&#10;
                                            · 🪞 完整镜像：让目标目录与源完全一致（含安全设置），会删除多余文件，慎用。&#10;
                                            · 🚚 数据迁移：复制后从源删除，把文件搬走，慎用。&#10;
                                            · 🔍 试运行：只预览将执行的操作，不实际复制，安全。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            本工具调用 Windows 自带的 robocopy.exe，界面风格参考 Fluent Design。
                                            更完整的参数说明见
                                            <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/robocopy" RequestNavigate="OnHelpLink">Microsoft 官方 robocopy 文档</Hyperlink>。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>





